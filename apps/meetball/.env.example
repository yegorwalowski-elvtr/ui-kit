# ---- Google sign-in (same setup as Photo Booth) ---------------------------
# Generate with: npx auth secret
AUTH_SECRET=

# Canonical public origin (required behind a reverse proxy such as Railway)
AUTH_URL=

# Google Cloud OAuth 2.0 Web application credentials
# (add <AUTH_URL>/api/auth/callback/google as an authorized redirect URI)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Local development ----------------------------------------------------
# Skip Google sign-in in a development build (npm run dev). Deliberately inert
# under npm run start, so it cannot open up a deployed host.
# MEETBALL_LOCAL_PREVIEW=1

# Skip Google sign-in on EVERY host, deployed ones included — staging review
# before OAuth exists. Remove it the moment AUTH_GOOGLE_* are set.
# MEETBALL_PUBLIC_PREVIEW=1
